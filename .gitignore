# Secrets and local configuration — never committed (CLAUDE.md, SPEC §11).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
blob-report/
