next-env.d.ts

# Terraform: state and plans hold infrastructure details and sometimes secrets.
# .terraform.lock.hcl IS committed (pins provider versions and hashes).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.auto.tfvars
*.auto.tfvars.json

# Evals and red team run outputs (datasets are versioned; results are CI artifacts).
evals/results/

# Logs
*.log
logs/

